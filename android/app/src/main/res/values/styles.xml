        <item name="android:statusBarColor">@color/brand_primary</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="PickearYaTheme.Dark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/brand_secondary</item>
        <item name="android:windowBackground">@drawable/pickear_ya_launch</item>
        <item name="android:navigationBarColor">@color/app_background</item>
