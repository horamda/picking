<resources>
    <style name="PickearYaTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/brand_secondary</item>
        <item name="android:windowBackground">@drawable/pickear_ya_launch</item>
        <item name="android:navigationBarColor">@color/app_surface</item>
        <item name="android:statusBarColor">@color/brand_primary</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="PickearYaTheme.Light" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/brand_secondary</item>
